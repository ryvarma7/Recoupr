# ── Database ────────────────────────────────────────────────────────────────
# Unset → falls back to a local SQLite file so the app still runs with zero setup.
DATABASE_URL=postgresql://recoupr:recoupr@localhost:5432/recoupr

# ── Razorpay (TEST MODE keys only — never live) ─────────────────────────────
# Empty → RazorpayClient runs in mock mode: returns realistic fake
# test-mode-shaped responses instead of calling the real API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Empty → webhook signature check is bypassed IN MOCK MODE ONLY, clearly logged.
# If a value is present it is NEVER bypassed; a bad signature is rejected (400).
RAZORPAY_WEBHOOK_SECRET=

# ── Anthropic ───────────────────────────────────────────────────────────────
# Empty → diagnosis/decision agents run in LLM_DISABLED mode:
# rule-only diagnosis, deterministic template decisions, clearly logged.
ANTHROPIC_API_KEY=

# ── Channel sender identity (simulated DLT / WhatsApp Business registration)
# false → the guardrail gate treats that channel as unavailable and routes
# messages to a verified alternative channel or blocks. Flip to true once the
# sender ID is actually registered in production.
SMS_SENDER_VERIFIED=false
WHATSAPP_SENDER_VERIFIED=false

# ── Locale ──────────────────────────────────────────────────────────────────
MERCHANT_TIMEZONE=Asia/Kolkata
